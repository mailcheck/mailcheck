{
  "name": "mailcheck",
  "title": "mailcheck",
  "description": "Reduce misspelled email addresses in your forms.",
  "keywords": [
    "form",
    "email",
    "spell check"
  ],
  "version": "1.1.2",
  "author": {
    "name": "Derrick Ko",
    "url": "http://derrickko.com",
    "email": "hello@derrickko.com"
  },
  "maintainers": [
    {
      "name": "Wei Lu",
      "url": "http://neo.com",
      "email": "wei@neo.com"
    }
  ],
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/mailcheck/mailcheck/blob/master/LICENSE"
    }
  ],
  "bugs": "https://github.com/mailcheck/mailcheck/issues",
  "homepage": "https://github.com/mailcheck/mailcheck",
  "docs": "https://github.com/mailcheck/mailcheck/blob/master/README.md",
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jquery": "3.5.34",
    "jquery": "3.7.1",
    "jquery-legacy": "npm:jquery@1.12.4",
    "esbuild": "0.25.10",
    "typescript": "^6.0.3",
    "ghooks": "^1.3.2",
    "grunt": "^1.6.1",
    "grunt-cli": "^1.5.0"
  },
  "main": "src/mailcheck.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git://github.com/mailcheck/mailcheck.git"
  },
  "scripts": {
    "test": "node script/test-all.js",
    "test:min": "node script/test-all.js --min",
    "test:types": "tsc -p spec/types/tsconfig.json && tsc -p spec/types/tsconfig.jquery.json",
    "test:package": "node script/test-package.js",
    "test:e2e": "playwright test",
    "test:ci": "npm run build:check && npm test && npm run test:types && npm run test:package && npm run test:e2e",
    "build": "node script/build.js",
    "build:check": "node script/build.js --check",
    "prepublishOnly": "npm run build:check && npm test && npm run test:types",
    "uglify": "npm run build"
  },
  "config": {
    "ghooks": {
      "pre-commit": "grunt"
    }
  }
}
